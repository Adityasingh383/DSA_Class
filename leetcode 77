class Solution {
    public List<List<Integer>> combine(int n, int k) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> c = new ArrayList<>();

        backtrack(1, c, res, n, k);
        return res;
    }

    private void backtrack(int start, List<Integer> c, List<List<Integer>> res, int n, int k) {
        if (c.size() == k) {
            res.add(new ArrayList<>(c));
            return;
        }

        for (int num = start; num <= n; num++) {
            c.add(num);
            backtrack(num + 1, c, res, n, k);
            c.remove(c.size() - 1);
        }
    } 
}
