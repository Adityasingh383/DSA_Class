class Solution {
    public boolean isSymmetric(TreeNode root) {
        if(root==null){
            return true;
        }
        if(mirror(root.left,root.right)){
            return true;
        }
        return false;
    }
    public boolean mirror(TreeNode n1,TreeNode n2){
        if(n1==null && n2==null){
            return true;
        }
        if(n1==null || n2==null){
            return false;
        }
        if(n1.val!=n2.val){
            return false;
        }
        return mirror(n1.left,n2.right) && mirror(n1.right,n2.left);
    }
}
